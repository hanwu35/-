# 数据库配置
MYSQL_URL=jdbc:mysql://mysql:3306/ai_health_check?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
MYSQL_USERNAME=hanwu
MYSQL_PASSWORD=WDz18708835370

# 连接池配置
DATASOURCE_MAX_POOL_SIZE=10
DATASOURCE_MIN_IDLE=5
DATASOURCE_CONNECTION_TIMEOUT=30000

# JPA 配置
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
HIBERNATE_FORMAT_SQL=true
HIBERNATE_USE_SQL_COMMENTS=true

# 服务器配置
SERVER_PORT=8080

# 日志级别（生产环境建议调高）
LOG_HIBERNATE_SQL=DEBUG
LOG_HIBERNATE_BINDER=TRACE
LOG_SPRING_DATA_JPA=DEBUG
LOG_APP_ROOT=INFO
LOG_PREDICTION_SERVICE=DEBUG
LOG_SPRING_WEB=INFO

# 日志文件配置
LOG_FILE=/app/logs/application.log
LOG_FILE_MAX_SIZE=10MB
LOG_FILE_MAX_HISTORY=10